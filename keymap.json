[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
    },
  },
  {
    "context": "Dock || Panel || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-f": "editor::Format",
    },
  },
  {
    "context": "Picker || Menu || Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
    },
  },
  {
    "context": "Picker || Menu || Editor",
    "bindings": {
      "ctrl-k": "menu::SelectPrevious",
    },
  },

  {
    "context": "Editor && (showing_completions || showing_code_actions)",
    "bindings": {
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },
  {
    "context": "Editor && (showing_completions || showing_code_actions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-s ctrl-t": "task::Spawn",
    },
  },
  {
    "bindings": {
      "ctrl-alt-v": "workspace::ToggleVimMode",
    },
  },
  {
    "context": "vim_mode",
    "bindings": {
      "ctrl-shift-s": "workspace::SaveAll",
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "ctrl-p ctrl-s": "project_symbols::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b ctrl-d": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-l ctrl-d": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-r ctrl-d": "workspace::ToggleRightDock",
    },
  },
  {
    "bindings": {
      "ctrl-g ctrl-p": "git_panel::Toggle",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-f ctrl-s": "buffer_search::Deploy"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-f": "buffer_search::Deploy"
    }
  }
]

