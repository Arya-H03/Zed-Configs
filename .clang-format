# clang-format configuration file
# Place this at the root of your C++ project as `.clang-format`
# It controls automatic code formatting with clang-format

# ---------------- Base style ----------------
# You can use LLVM, Google, Chromium, Microsoft, Mozilla, WebKit
# # Language specific overrides
Language: Cpp

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
IndentCaseLabels: true
NamespaceIndentation: None

# Braces (Allman style)
BreakBeforeBraces: Allman
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Always
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterEnum: true
  BeforeElse: true

# Line length
ColumnLimit: 100

# Alignment
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignTrailingComments: true
PointerAlignment: Left

# Spaces
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInAngles: false
SpacesInParentheses: false
SpaceAfterCStyleCast: false

# Breaking long lines
AllowShortFunctionsOnASingleLine: All # Put short functions on one line
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Empty
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeColon

# Includes
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup

# Misc
Cpp11BracedListStyle: true
FixNamespaceComments: true
ReflowComments: true
